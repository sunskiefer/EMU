{
  "name": "808MPC",
  "vendor": "L'Cronx",
  "uid": "E808",
  "version": 1000,
  "so": "808mpc.so",
  "params": "params.json",
  "layout": "layout.conf",
  "cc": false,
  "nrpn": false,
  "defines": {
    "MODULE_SUBDIR": "\"roms\""
  },
  "build": {
